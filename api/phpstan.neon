includes:
    - phpstan-baseline.neon
parameters:
    level: 5
    phpVersion: 80200
    paths:
        - app
        - data
        - lib
        - utils
        - modules
    # Legacy classes used by the API (loaded at runtime by legacy's composer autoloader)
    scanFiles:
        - ../legacy/lib/Utility/SiteUrl.php
    excludePaths:
        - vendor/*
        - cache/*
        - tests/*
